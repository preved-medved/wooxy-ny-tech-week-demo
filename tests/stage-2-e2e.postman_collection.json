    {
      "name": "POST /v1/users/registration — 409 duplicate email",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 409', () => pm.response.to.have.status(409));",
              "const body = pm.response.json();",
              "pm.test('code is email_already_registered', () => pm.expect(body.code).to.eql('email_already_registered'));",
              "pm.test('message is present', () => pm.expect(body.message).to.be.a('string').and.not.empty);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"name\": \"{{test_name}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/users/registration",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "users",
            "registration"
          ]
        }
      },
      "response": []
    },
