    {
      "name": "POST /v1/users/login — 200 success (after manual email verification)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "pm.test('Content-Type is JSON', () => ",
              "    pm.response.to.have.header('Content-Type', 'application/json')",
              ");",
              "",
              "const body = pm.response.json();",
              "pm.test('access_token is present', () => pm.expect(body.access_token).to.be.a('string').and.not.empty);",
              "pm.test('token_type is Bearer', () => pm.expect(body.token_type).to.eql('Bearer'));",
              "pm.test('expires_in is a positive number', () => pm.expect(body.expires_in).to.be.a('number').and.above(0));",
              "pm.test('user.id is present', () => pm.expect(body.user.id).to.be.a('number').and.above(0));",
              "pm.test('user.email_verified is true', () => pm.expect(body.user.email_verified).to.be.true);",
              "pm.collectionVariables.set('access_token', body.access_token);",
              "pm.collectionVariables.set('user_id', body.user.id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
