    {
      "name": "PATCH /v1/users/{user_id}/edit — 200 update name",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "pm.test('Content-Type is JSON', () => ",
              "    pm.response.to.have.header('Content-Type', 'application/json')",
              ");",
              "",
              "const body = pm.response.json();",
              "pm.test('name updated', () => pm.expect(body.name).to.eql('John Smith'));",
              "pm.test('id matches', () => pm.expect(body.id).to.eql(parseInt(pm.collectionVariables.get('user_id'))));",
              "pm.test('email unchanged', () => pm.expect(body.email).to.be.a('string').and.not.empty);",
              "pm.test('updated_at is present', () => pm.expect(body.updated_at).to.be.a('string').and.not.empty);"
            ],
